package com.tution.util;

/**
 * Razorpay credentials + mode switch.
 *
 * Copy this file to RazorpayConfig.java and fill in your own values —
 * RazorpayConfig.java is gitignored so real credentials never get committed.
 *
 * TEST/MOCK MODE (default): with MOCK_MODE = true (or blank keys), "Pay Online"
 * does NOT contact Razorpay — it simulates a successful payment so you can test
 * the flow and create dummy online entries.
 *
 * GOING LIVE: paste your keys from the Razorpay Dashboard (Settings → API Keys),
 * use rzp_test_... while testing or rzp_live_... for production, and set
 * MOCK_MODE = false. No other code changes are needed.
 */
public class RazorpayConfig {

    public static final String  KEY_ID     = "";
    public static final String  KEY_SECRET = "";
    public static final boolean MOCK_MODE  = true;

    /** True when payments should be simulated instead of sent to Razorpay. */
    public static boolean isMock() {
        return MOCK_MODE
            || KEY_ID == null || KEY_ID.trim().isEmpty()
            || !KEY_ID.startsWith("rzp_");
    }

    private RazorpayConfig() { }
}
